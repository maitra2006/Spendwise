rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Groups: members can read and write
    match /groups/{groupId} {
      allow read, write: if request.auth != null && (request.auth.uid in resource.data.memberIds || request.auth.uid in request.resource.data.memberIds);
    }

    // Expenses: members of the group can read and write
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    // Settlements
    match /settlements/{settlementId} {
      allow read, write: if request.auth != null;
    }
  }
}
